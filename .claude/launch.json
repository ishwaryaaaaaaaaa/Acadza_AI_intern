{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-X",
        "utf8",
        "-m",
        "uvicorn",
        "server.app:app",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "server",
        "--reload-dir",
        "engine"
      ],
      "port": 8000
    },
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "console",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}